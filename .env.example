# AI Interview Agent - Environment Configuration
# Copy this file to .env and fill in your values

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=interview_agent

# OpenAI Configuration (optional, for LLM-based features)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Whisper Configuration
WHISPER_MODEL=base

# TTS Configuration
TTS_ENGINE=gtts
TTS_LANGUAGE=en

# Video Configuration
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480

# NLP Configuration
SPACY_MODEL=en_core_web_sm
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Interview Configuration
DEFAULT_QUESTIONS_COUNT=10
MAX_FOLLOW_UPS=2
FOLLOW_UP_PROBABILITY=0.3

# Logging
LOG_LEVEL=INFO

# Streamlit
STREAMLIT_PORT=8501
