# ═══════════════════════════════════════════════════════════════
# AI Interview Agent — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interview_agent

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated origins (no spaces around commas)
CORS_ORIGINS=http://localhost:3000

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ── S3 / MinIO ──────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=interview-agent
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Email (SMTP) ─────────────────────────────────────────────
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=noreply@interviewagent.com

# ── App ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
DISABLE_RATE_LIMIT=false

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
